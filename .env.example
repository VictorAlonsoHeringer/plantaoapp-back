# Banco de Dados PostgreSQL
# Substitua com suas credenciais do banco de dados no Dockploy
DATABASE_URL="postgresql://usuario:senha@host:5432/plantaoapp?schema=public"

# JWT Secret
# Gere uma chave secreta forte e única (mínimo 32 caracteres)
# Exemplo para gerar: openssl rand -base64 32
JWT_SECRET="sua-chave-secreta-super-segura-aqui-minimo-32-caracteres"

# Porta da aplicação (padrão: 3333)
PORT=3333

# Ambiente
NODE_ENV=production

# CORS Origins (adicione os domínios permitidos separados por vírgula)
# Exemplo: CORS_ORIGINS="https://seuapp.com,https://www.seuapp.com"
CORS_ORIGINS="*"
